        {
          "name": "TC-01: Kiểm tra trạng thái hệ thống",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code là 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Kiểu dữ liệu JSON hợp lệ', function () {",
                  "    pm.response.to.be.json;",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('hasData');",
                  "    pm.expect(jsonData).to.have.property('overridesCount');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "state"
              ]
            },
            "description": "Lấy trạng thái tổng quan của hệ thống: có dữ liệu chưa, đã giải giai đoạn 1/2 chưa, số lượng override."
          }
